# ============================================
# Motorcycle & Scooter Dealership ERP System
# Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_db?schema=public"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-random-64-char-secret-for-access-tokens"
JWT_REFRESH_SECRET="change-this-to-a-different-random-64-char-secret-for-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
API_PORT=3000
API_HOST="localhost"
NODE_ENV="development"

# Frontend
VITE_API_URL="http://localhost:3000/api"

# Organization Defaults
DEFAULT_CURRENCY="EGP"
DEFAULT_VAT_RATE="14"
DEFAULT_LANGUAGE="ar"
DEFAULT_COUNTRY="EG"

# Logging
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:5173"
