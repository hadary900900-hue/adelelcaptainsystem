{
  "name": "@erp/root",
  "version": "1.0.0",
  "private": true,
  "description": "Motorcycle & Scooter Dealership ERP System",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @erp/api dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @erp/database db:migrate",
    "db:migrate:dev": "pnpm --filter @erp/database db:migrate:dev",
    "db:push": "pnpm --filter @erp/database db:push",
    "db:seed": "pnpm --filter @erp/database db:seed",
    "db:studio": "pnpm --filter @erp/database db:studio",
    "db:generate": "pnpm --filter @erp/database db:generate",
    "db:reset": "pnpm --filter @erp/database db:reset",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
